NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_BASE_RPC_URL=

# Optional remote libSQL/Turso database configuration.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Coinbase CDP API keys — REQUIRED for x402 settlement on Base mainnet.
# Without these, the default x402.org testnet facilitator is used and
# mainnet settlement fails with "unexpected_error".
# Create keys at https://portal.cdp.coinbase.com/ (Server/Secret API key).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
